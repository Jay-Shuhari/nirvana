SECRET_KEY=change-me
DEBUG=1
CORS_ORIGIN=http://localhost:5173
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Store the complete private key as one value with literal \n between PEM lines.
GITHUB_APP_PRIVATE_KEY=
# Use a random secret shared with GitHub App > Webhook > Secret.
GITHUB_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

# --- Identity: Google/GitHub sign-in via Firebase Authentication ---------------
# Firebase console > Project settings > General > Project ID (public, not a secret).
FIREBASE_PROJECT_ID=
# Academy policy: comma-separated verified emails or @domains that become supervisors on first sign-in.
SUPERVISOR_EMAILS=
# 1 = allow legacy email/password sign-up (defaults to on only when DEBUG=1).
LEGACY_PASSWORD_SIGNUP=

# --- Email notifications (Supabase or Custom SMTP) --------------------------
EMAIL_NOTIFICATIONS_ENABLED=1
# "supabase" sends via Supabase Edge Function using SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY.
# "smtp" sends via custom SMTP host settings below.
EMAIL_PROVIDER=supabase
DEFAULT_FROM_EMAIL="Metis <notifications@your-domain.com>"
SUPABASE_EMAIL_FUNCTION_NAME=send-email

# Optional SMTP settings (only needed when EMAIL_PROVIDER=smtp):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# --- Supabase ---------------------------------------------------------------
# Dashboard > Connect > Session pooler URI (Django uses this; leave empty for local SQLite).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Dashboard > Project Settings > API
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_ANON_KEY=
# SECRET. Server only. Never put in the frontend or commit it. Bypasses all RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI requirements check (optional, free tiers exist) ---------------------
# Leave empty to use the rule-based check. Pick ONE provider, copy its model name from its console.
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq  (free tier): LLM_BASE_URL=https://api.groq.com/openai/v1
# xAI Grok         : LLM_BASE_URL=https://api.x.ai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
