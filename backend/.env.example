SECRET_KEY=change-me
DEBUG=1
CORS_ORIGIN=http://localhost:5173
GITHUB_TOKEN=

# --- Supabase ---------------------------------------------------------------
# Dashboard > Connect > Session pooler URI (Django uses this; leave empty for local SQLite).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Dashboard > Project Settings > API
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_ANON_KEY=
# SECRET. Server only. Never put in the frontend or commit it. Bypasses all RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI requirements check (optional, free tiers exist) ---------------------
# Leave empty to use the rule-based check. Pick ONE provider, copy its model name from its console.
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq  (free tier): LLM_BASE_URL=https://api.groq.com/openai/v1
# xAI Grok         : LLM_BASE_URL=https://api.x.ai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
