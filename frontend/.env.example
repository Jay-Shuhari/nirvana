# Leave VITE_API_URL empty when Django serves the app (one URL). Only set it for `npm run dev` on port 5173.
# VITE_API_URL=http://localhost:8000/api
VITE_SUPABASE_URL=https://PROJECTREF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These values are public identifiers, not secrets. Enables "Continue with Google/GitHub".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
